# This file contains the fastlane.tools configuration
# Learn more: https://docs.fastlane.tools

default_platform(:ios)

platform :ios do
  project_path = "AvApp.xcodeproj"
  scheme_name = "AvApp"
  default_device = ENV["SIMULATOR_DEVICE"] || "iPhone 17 Pro"

  desc "Run AvAppNetworking package tests"
  lane :package_tests do
    sh("swift test --package-path ../Packages/AvAppNetworking")
  end

  desc "Run all tests (unit + UI) using the AvApp scheme"
  lane :tests do
    run_tests(
      project: project_path,
      scheme: scheme_name,
      devices: [default_device],
      clean: true,
      result_bundle: true,
      xcargs: "-parallel-testing-enabled NO"
    )
  end

  # Convenience alias to align with `fastlane test`
  lane :test do
    tests
  end

  desc "Simple demo lane"
  lane :demo do
    UI.message("🚀 Fastlane Demo Running!")
    sh "echo '➡️  Running a shell command inside Fastlane...'"

    UI.message("🔧 Pretending to build the app...")
    version = get_version_number(xcodeproj: "AvApp.xcodeproj")
    UI.message("📦 Current app version is: #{version}")
    UI.message("🎉 Fastlane demo finished successfully!")
  end

  desc "Hello from fastlane"
  lane :hello do
    UI.message("👋 Hello from lane :hello!")
  end

  desc "Hello world example"
  lane :world do
    hello
    UI.message("🌍 Welcome to Fastlane!")
  end

  desc "Quick smoke tests on a simulator"
  lane :quick_tests do
    scan(
      project: project_path,
      scheme: scheme_name,
      devices: [default_device]
    )
  end

  desc "Generate UI screenshots with fastlane snapshot"
  lane :snapshot do
    snapshot(
      project: project_path,
      scheme: scheme_name,
      devices: [default_device],
      languages: ["en-US"],
      clear_previous_screenshots: true,
      override_status_bar: true,
      xcargs: "-ui_testing_screenshots"
    )
  end

  desc "Export IPA for App Store"
  lane :export_app do
    gym(
      project: project_path,
      scheme: scheme_name,
      export_method: "app-store", # or: "ad-hoc", "development", "enterprise"
      output_directory: "build",
      export_xcargs: "-allowProvisioningUpdates",
      output_name: "ReleaseAppAvApp.ipa",
      clean: true
    )
  end

  desc "Upload IPA to App Store Connect"
  lane :upload_app do
    deliver(
      ipa: "build/ReleaseAppAvApp.ipa",
      skip_screenshots: true,
      skip_metadata: true,
      skip_app_version_update: true,
      force: true
    )
  end

  desc "Export and upload"
  lane :release_app do
    export_app
    upload_app
  end
end
